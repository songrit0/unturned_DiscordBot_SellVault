# Discord
DISCORD_TOKEN=your-bot-token-here
GUILD_ID=000000000000000000          # your server id (for instant slash-command sync)
ADMIN_ROLE_ID=000000000000000000     # role allowed to run admin commands (optional; admins always allowed)

# MySQL (same database the Unturned plugins use)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=unturned
DB_USER=root
DB_PASSWORD=123456

# Table prefixes (match the plugins' config)
SV_PREFIX=sv_
RC_PREFIX=rc_

COIN_NAME=Coin

# Periodic backfill of sv_links.discord_username via the Discord HTTP API.
# Set to 0 to disable the in-bot loop (the CLI `python -m backfill_usernames` still works).
USERNAME_BACKFILL_INTERVAL_MIN=30
