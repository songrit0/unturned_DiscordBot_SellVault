# Discord
DISCORD_TOKEN=your-bot-token-here
GUILD_ID=000000000000000000          # your server id (for instant slash-command sync)
ADMIN_ROLE_ID=000000000000000000     # role allowed to run admin commands (optional; admins always allowed)

# MySQL (same database the Unturned plugins use)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=unturned
DB_USER=root
DB_PASSWORD=123456

# Table prefixes (match the plugins' config)
SV_PREFIX=sv_
RC_PREFIX=rc_

COIN_NAME=Coin

# Periodic backfill of sv_links.discord_username via the Discord HTTP API.
# Set to 0 to disable the in-bot loop (the CLI `python -m backfill_usernames` still works).
USERNAME_BACKFILL_INTERVAL_MIN=30

# VIP role sync — keep one Discord role in lockstep with VIP status (sv_vip_grants). The bot
# adds the role to active VIPs and removes it from everyone else, on GUILD_ID, every interval.
# REQUIRES (server-side, once): Server Members Intent ON in the Dev Portal, the bot to have
# Manage Roles, and the bot's top role ABOVE VIP_ROLE_ID in the role list. Defaults work as-is.
VIP_ROLE_ID=1515091339597975794      # role given to active VIPs (removed when VIP lapses)
VIP_ROLE_SYNC_INTERVAL_MIN=5         # full reconcile period (minutes)
VIP_ROLE_SYNC_ENABLED=1              # 0 = disable the loop entirely
VIP_ROLE_SYNC_DRYRUN=0               # 1 = log intended add/remove without touching roles

# In-game chat webhook relay channel: bot replies under "💬 Name: text" webhook messages
# with an EN -> TH translation (name is never translated). 0 disables it.
GAME_CHAT_CHANNEL_ID=1508058571533979748
